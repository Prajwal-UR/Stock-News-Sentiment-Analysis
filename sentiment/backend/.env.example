APP_ENV=development
ENABLE_DEMO_MODE=false
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_MAX_AGE_DAYS=30
GNEWS_API_KEY=
GNEWS_MAX_AGE_DAYS=30
GNEWS_PAGE_SIZE=10
GNEWS_REQUEST_INTERVAL_SECONDS=1.0
